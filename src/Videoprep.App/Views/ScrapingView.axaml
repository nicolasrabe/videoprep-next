<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Videoprep.App.ViewModels"
             xmlns:s="using:Videoprep.App.Services"
             x:Class="Videoprep.App.Views.ScrapingView"
             x:DataType="vm:ScrapingViewModel">
  <UserControl.Styles>
    <!-- Suscripciones: the name in red when the last check failed (tooltip says why), dimmed when switched off. -->
    <Style Selector="TextBlock.err">
      <Setter Property="Foreground" Value="Red" />
    </Style>
    <Style Selector="TextBlock.off">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="4,10,4,4">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ToggleButton x:Name="ExploreButton" Content="{s:T sc_explore}" IsChecked="{Binding ShowExplore, Mode=OneWay}" />
      <ToggleButton x:Name="SubsButton" Content="{s:T sc_subs}" IsChecked="{Binding ShowSubscriptions, Mode=OneWay}" />
    </StackPanel>

    <!-- Explorar (SCRAPING_SPEC 1) -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8" IsVisible="{Binding ShowExplore}">
      <Border Classes="card">
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SourceBox" Text="{Binding Explore.SourceText}" PlaceholderText="{s:T sc_url_ph}" IsEnabled="{Binding Explore.IsIdle}" />
            <Panel Grid.Column="1">
              <Button Classes="o" Content="{s:T sc_search}" Command="{Binding Explore.SearchCommand}" IsVisible="{Binding Explore.IsIdle}" />
              <Button Classes="r" Content="{s:T sc_cancel}" Command="{Binding Explore.CancelCommand}" IsVisible="{Binding Explore.IsSearching}" />
            </Panel>
          </Grid>
          <WrapPanel ItemSpacing="10" LineSpacing="4">
            <TextBlock Classes="muted" Text="{s:T sc_tabs}" VerticalAlignment="Center" />
            <CheckBox Content="{s:T sc_tabs_videos}" IsChecked="{Binding Explore.TabVideos}" />
            <CheckBox Content="{s:T sc_tabs_shorts}" IsChecked="{Binding Explore.TabShorts}" />
            <CheckBox Content="{s:T sc_tabs_streams}" IsChecked="{Binding Explore.TabStreams}" />
            <CheckBox Content="{s:T sc_tabs_playlists}" IsChecked="{Binding Explore.TabPlaylists}" />
            <TextBlock Classes="muted" Text="{s:T sc_tabs_hint}" VerticalAlignment="Center" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Classes="card">
        <StackPanel Spacing="7">
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBlock Classes="muted" Text="{s:T sc_from}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.FromText}" Width="110" PlaceholderText="{s:T sc_date_ph}" Classes.bad="{Binding Explore.Filter.FromBad}" />
            <TextBlock Classes="muted" Text="{s:T sc_to}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.ToText}" Width="110" PlaceholderText="{s:T sc_date_ph}" Classes.bad="{Binding Explore.Filter.ToBad}" />
            <TextBlock Classes="muted" Text="{s:T sc_dur_min}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBox Text="{Binding Explore.Filter.MinText}" Width="80" PlaceholderText="M:SS" Classes.bad="{Binding Explore.Filter.MinBad}" />
            <TextBlock Classes="muted" Text="{s:T sc_dur_max}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.MaxText}" Width="80" PlaceholderText="H:MM:SS" Classes.bad="{Binding Explore.Filter.MaxBad}" />
          </WrapPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBlock Classes="muted" Text="{s:T sc_incl}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.IncludeText}" Width="170" />
            <TextBlock Classes="muted" Text="{s:T sc_excl}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.ExcludeText}" Width="170" />
            <TextBlock Classes="muted" Text="{s:T sc_max}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.MaxCountText}" Width="70" Classes.bad="{Binding Explore.Filter.MaxCountBad}" />
          </WrapPanel>
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <TextBlock Classes="muted" Text="{s:T sc_order}" VerticalAlignment="Center" />
            <ComboBox SelectedIndex="{Binding Explore.Filter.OrderIndex}" MinWidth="170">
              <ComboBoxItem Content="{s:T sc_order_new}" />
              <ComboBoxItem Content="{s:T sc_order_old}" />
            </ComboBox>
            <CheckBox Content="{s:T sc_skip_live}" IsChecked="{Binding Explore.Filter.SkipLive}" />
            <CheckBox Content="{s:T sc_skip_members}" IsChecked="{Binding Explore.Filter.SkipMembers}" />
            <CheckBox Content="{s:T sc_skip_done}" IsChecked="{Binding Explore.Filter.SkipDone}" />
            <Button Content="{s:T sc_apply}" Command="{Binding Explore.ApplyFiltersCommand}" IsEnabled="{Binding Explore.IsIdle}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Explore.StatusLine}" TextWrapping="Wrap"
                 IsVisible="{Binding Explore.StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <DataGrid Grid.Row="3" ItemsSource="{Binding Explore.Rows}" HeadersVisibility="Column" CanUserSortColumns="False"
                CanUserReorderColumns="False" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="40">
            <DataTemplate x:DataType="vm:ExploreRow">
              <CheckBox IsChecked="{Binding Selected}" IsVisible="{Binding CanSelect}" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{s:T sc_col_title}" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_date}" Binding="{Binding DateText}" Width="115" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_dur}" Binding="{Binding DurationText}" Width="105" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_views}" Binding="{Binding ViewsText}" Width="90" IsReadOnly="True" />
          <DataGridTemplateColumn Header="{s:T sc_col_status}" Width="140">
            <DataTemplate x:DataType="vm:ExploreRow">
              <Panel Margin="10,0">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" IsVisible="{Binding !CanExpand}" />
                <Button Content="{s:T sc_expand}" Padding="8,2" IsVisible="{Binding CanExpand}"
                        Command="{Binding $parent[UserControl].((vm:ScrapingViewModel)DataContext).Explore.ExpandCommand}"
                        CommandParameter="{Binding}" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="4" Classes="muted" Text="{s:T sc_approx_note}" TextWrapping="Wrap" IsVisible="{Binding Explore.HasApproxDates}" />
      <Border Grid.Row="5" Classes="card">
        <WrapPanel ItemSpacing="24" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{s:T sc_all}" Command="{Binding Explore.SelectAllCommand}" />
            <Button Content="{s:T sc_none}" Command="{Binding Explore.SelectNoneCommand}" />
            <Button Content="{s:T sc_invert}" Command="{Binding Explore.InvertCommand}" />
            <TextBlock Classes="muted" Text="{Binding Explore.SelectedText}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" Text="{s:T lbl_fmt}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Explore.Format.FormatChoices}" SelectedItem="{Binding Explore.Format.SelectedFormat}" MinWidth="200" />
            <ComboBox ItemsSource="{Binding Explore.Format.ResolutionChoices}" SelectedItem="{Binding Explore.Format.SelectedResolution}" MinWidth="90" />
            <ComboBox ItemsSource="{Binding Explore.Format.ProfileChoices}" SelectedItem="{Binding Explore.Format.PickedProfile}"
                      PlaceholderText="{s:T ph_profile}" MinWidth="170" AutomationProperties.Name="{s:T lbl_profile}" />
            <Button Classes="o" Content="{s:T sc_to_queue}" Command="{Binding Explore.SendToQueueCommand}" IsEnabled="{Binding Explore.IsIdle}" />
            <Button Classes="g" Content="{s:T sc_subscribe}" Command="{Binding SubscribeFromExploreCommand}" IsEnabled="{Binding Explore.IsIdle}" />
          </StackPanel>
        </WrapPanel>
      </Border>
    </Grid>

    <!-- Suscripciones (SCRAPING_SPEC 2) -->
    <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8" IsVisible="{Binding ShowSubscriptions}">
      <DataGrid ItemsSource="{Binding Subscriptions.Rows}" SelectedItem="{Binding Subscriptions.Selected}" SelectionMode="Single"
                HeadersVisibility="Column" CanUserSortColumns="False" CanUserReorderColumns="False" IsEnabled="{Binding Subscriptions.IsIdle}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{s:T sc_col_on}" Width="80">
            <DataTemplate x:DataType="vm:SubscriptionRow">
              <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{s:T sc_col_channel}" Width="*">
            <DataTemplate x:DataType="vm:SubscriptionRow">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                         Classes.err="{Binding HasError}" Classes.off="{Binding !Enabled}"
                         ToolTip.Tip="{Binding Error}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{s:T sc_col_what}" Binding="{Binding What}" Width="170" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_filters}" Binding="{Binding FiltersText}" Width="*" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_profile}" Binding="{Binding ProfileText}" Width="140" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_format}" Binding="{Binding FormatText}" Width="120" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_last}" Binding="{Binding LastText}" Width="110" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_newcount}" Binding="{Binding NewText}" Width="90" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Subscriptions.StatusLine}" TextWrapping="Wrap"
                 IsVisible="{Binding Subscriptions.StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Border Grid.Row="2" Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="o" Content="{s:T sc_add}" Command="{Binding Subscriptions.AddCommand}" IsEnabled="{Binding Subscriptions.IsIdle}" />
            <Button Content="{s:T sc_edit}" Command="{Binding Subscriptions.EditCommand}" IsEnabled="{Binding Subscriptions.IsIdle}" />
            <Button Classes="r" Content="{s:T sc_remove}" Command="{Binding Subscriptions.RemoveCommand}" IsEnabled="{Binding Subscriptions.IsIdle}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="{s:T sc_check_now}" Command="{Binding Subscriptions.CheckSelectedCommand}" IsVisible="{Binding Subscriptions.IsIdle}" />
            <Button Classes="g" Content="{s:T sc_check_all}" Command="{Binding Subscriptions.CheckAllCommand}" IsVisible="{Binding Subscriptions.IsIdle}" />
            <Button Classes="r" Content="{s:T sc_stop_check}" Command="{Binding Subscriptions.StopCheckCommand}" IsVisible="{Binding Subscriptions.IsChecking}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="3" Classes="card">
        <StackPanel Spacing="7">
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <CheckBox Content="{s:T sc_check_start}" IsChecked="{Binding Subscriptions.CheckOnStart}" />
            <CheckBox Content="{s:T sc_every_pre}" IsChecked="{Binding Subscriptions.CheckEvery}" />
            <NumericUpDown Value="{Binding Subscriptions.EveryHours}" Minimum="1" Maximum="24" Increment="1" FormatString="0" Width="110" />
            <TextBlock Text="{s:T sc_every_post}" VerticalAlignment="Center" />
          </WrapPanel>
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <CheckBox Content="{s:T sc_task}" IsChecked="{Binding Subscriptions.TaskInstalled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" />
            <Button Content="{s:T sc_task_config}" Command="{Binding Subscriptions.ConfigureTaskCommand}" />
            <Button Content="{s:T sc_task_remove}" Command="{Binding Subscriptions.RemoveTaskCommand}" IsVisible="{Binding Subscriptions.TaskInstalled}" />
          </WrapPanel>
          <TextBlock Classes="muted" Text="{s:T sc_subs_note}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{s:T sc_warn_account}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
