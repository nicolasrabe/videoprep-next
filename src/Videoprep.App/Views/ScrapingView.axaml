<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Videoprep.App.ViewModels"
             xmlns:s="using:Videoprep.App.Services"
        xmlns:c="clr-namespace:Videoprep.Controls;assembly=Videoprep.Controls"
             xmlns:v="using:Videoprep.App.Views"
             x:Class="Videoprep.App.Views.ScrapingView"
             x:DataType="vm:ScrapingViewModel">
  <UserControl.Styles>
    <!-- Suscripciones: the name in red when the last check failed (tooltip says why), dimmed when switched off. -->
    <Style Selector="TextBlock.err">
      <Setter Property="Foreground" Value="Red" />
    </Style>
    <Style Selector="TextBlock.off">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="4,10,4,4">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ToggleButton x:Name="ExploreButton" Content="{c:T sc_explore}" IsChecked="{Binding ShowExplore, Mode=OneWay}" />
      <ToggleButton x:Name="SubsButton" Content="{c:T sc_subs}" IsChecked="{Binding ShowSubscriptions, Mode=OneWay}" />
    </StackPanel>

    <!-- Explorar in three steps (RONDA 1), each one a foldable card (RONDA 4): the results take all the free height. -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" IsVisible="{Binding ShowExplore}">
      <!-- ① Enlace: folded, only the channel (avatar, name, @) stays in the header -->
      <v:CollapsibleSection x:Name="LinkCard" Title="{c:T sc_step1}" IsExpanded="{Binding Explore.LinkExpanded}">
        <v:CollapsibleSection.HeaderContent>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Explore.HasSource}" Margin="6,0,0,0">
            <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Background="{DynamicResource Bd}">
              <Image Source="{Binding Explore.Avatar}" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="SourceNameText" Classes="title" Text="{Binding Explore.SourceName}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Explore.SourceHandle}" VerticalAlignment="Center" />
          </StackPanel>
        </v:CollapsibleSection.HeaderContent>
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SourceBox" Text="{Binding Explore.SourceText}" PlaceholderText="{c:T sc_url_ph}" IsEnabled="{Binding Explore.IsIdle}" />
            <Button Grid.Column="1" Classes="o" Content="{c:T sc_load}" Command="{Binding Explore.LoadCommand}" IsEnabled="{Binding Explore.IsIdle}" />
          </Grid>
          <c:LoadingText What="{c:T load_channel}" IsVisible="{Binding Explore.IsLoadingSource}" />
          <TextBlock Classes="muted" Text="{Binding Explore.LoadNote}" TextWrapping="Wrap" IsVisible="{Binding !Explore.IsLoadingSource}" />
          <!-- The link is identified: the tabs to read -->
          <WrapPanel ItemSpacing="10" LineSpacing="4" IsVisible="{Binding Explore.HasSource}">
            <CheckBox Content="{c:T sc_tabs_videos}" IsChecked="{Binding Explore.TabVideos}" />
            <CheckBox Content="{c:T sc_tabs_shorts}" IsChecked="{Binding Explore.TabShorts}" />
            <CheckBox Content="{c:T sc_tabs_streams}" IsChecked="{Binding Explore.TabStreams}" />
            <CheckBox Content="{c:T sc_tabs_playlists}" IsChecked="{Binding Explore.TabPlaylists}" />
          </WrapPanel>
        </StackPanel>
      </v:CollapsibleSection>

      <!-- ② Filtros: folded, one line says what is applied. "Buscar videos" folds it. -->
      <v:CollapsibleSection x:Name="FiltersCard" Grid.Row="1" Title="{c:T sc_step2}" Summary="{Binding Explore.SummaryText}"
                            IsExpanded="{Binding Explore.FiltersExpanded}" IsVisible="{Binding Explore.HasSource}">
        <StackPanel Spacing="7">
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBlock Classes="muted" Text="{c:T sc_published}" VerticalAlignment="Center" />
            <ToggleButton Content="{c:T sc_p24}" IsChecked="{Binding Explore.Preset24h, Mode=OneWay}" Command="{Binding Explore.QuickDatesCommand}" CommandParameter="24h" />
            <ToggleButton Content="{c:T sc_p7}" IsChecked="{Binding Explore.Preset7d, Mode=OneWay}" Command="{Binding Explore.QuickDatesCommand}" CommandParameter="7d" />
            <ToggleButton Content="{c:T sc_pmonth}" IsChecked="{Binding Explore.PresetMonth, Mode=OneWay}" Command="{Binding Explore.QuickDatesCommand}" CommandParameter="month" />
            <ToggleButton Content="{c:T sc_pbetween}" IsChecked="{Binding Explore.PresetBetween, Mode=OneWay}" Command="{Binding Explore.QuickDatesCommand}" CommandParameter="between" />
            <TextBox Text="{Binding Explore.Filter.FromText}" Width="110" PlaceholderText="{c:T sc_date_ph}" Classes.bad="{Binding Explore.Filter.FromBad}" />
            <TextBlock Classes="muted" Text="{c:T sc_and}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.ToText}" Width="110" PlaceholderText="{c:T sc_date_ph}" Classes.bad="{Binding Explore.Filter.ToBad}" />
          </WrapPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBlock Classes="muted" Text="{c:T sc_show_up}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.Filter.MaxCountText}" Width="70" PlaceholderText="{c:T sc_all_ph}" Classes.bad="{Binding Explore.Filter.MaxCountBad}" />
            <TextBlock Classes="muted" Text="{c:T sc_videos_word}" VerticalAlignment="Center" />
            <ComboBox SelectedIndex="{Binding Explore.Filter.OrderIndex}" MinWidth="170">
              <ComboBoxItem Content="{c:T sc_order_new}" />
              <ComboBoxItem Content="{c:T sc_order_old}" />
            </ComboBox>
            <CheckBox Content="{c:T sc_skip_live_members}" IsChecked="{Binding Explore.Filter.SkipLiveMembers}" />
            <CheckBox Content="{c:T sc_skip_done}" IsChecked="{Binding Explore.Filter.SkipDone}" />
          </WrapPanel>
          <Expander Header="{c:T sc_more_filters}">
            <WrapPanel ItemSpacing="8" LineSpacing="6" Margin="0,6,0,0">
              <TextBlock Classes="muted" Text="{c:T sc_dur_min}" VerticalAlignment="Center" />
              <TextBox Text="{Binding Explore.Filter.MinText}" Width="80" PlaceholderText="M:SS" Classes.bad="{Binding Explore.Filter.MinBad}" />
              <TextBlock Classes="muted" Text="{c:T sc_dur_max}" VerticalAlignment="Center" />
              <TextBox Text="{Binding Explore.Filter.MaxText}" Width="80" PlaceholderText="H:MM:SS" Classes.bad="{Binding Explore.Filter.MaxBad}" />
              <TextBlock Classes="muted" Text="{c:T sc_incl}" VerticalAlignment="Center" Margin="10,0,0,0" />
              <TextBox Text="{Binding Explore.Filter.IncludeText}" Width="170" />
              <TextBlock Classes="muted" Text="{c:T sc_excl}" VerticalAlignment="Center" />
              <TextBox Text="{Binding Explore.Filter.ExcludeText}" Width="170" />
            </WrapPanel>
          </Expander>
          <Border Classes="card" Padding="10,8">
            <StackPanel Spacing="3">
              <TextBlock TextWrapping="Wrap">
                <Run Text="{c:T sc_will_search}" FontWeight="SemiBold" />
                <Run Text="{Binding Explore.SummaryText}" />
              </TextBlock>
              <TextBlock Classes="muted" Text="{Binding Explore.EstimateText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" Text="{c:T sc_enter_hint}" VerticalAlignment="Center" />
            <Panel Grid.Column="1">
              <Button Classes="o" Content="{c:T sc_search}" Command="{Binding Explore.SearchCommand}" IsVisible="{Binding Explore.IsIdle}" />
              <Button Classes="r" Content="{c:T sc_cancel}" Command="{Binding Explore.CancelCommand}" IsVisible="{Binding Explore.IsSearching}" />
            </Panel>
          </Grid>
        </StackPanel>
      </v:CollapsibleSection>

      <!-- ③ Resultados: grows; the table scrolls by itself with its header fixed -->
      <v:CollapsibleSection x:Name="ResultsCard" Grid.Row="2" Title="{c:T sc_step3}" Grows="True" IsVisible="{Binding Explore.HasSearched}">
        <v:CollapsibleSection.HeaderContent>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
            <TextBlock x:Name="ResultsHeaderText" Text="{Binding Explore.ResultsHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Explore.DatesText}" VerticalAlignment="Center"
                       IsVisible="{Binding Explore.DatesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding Explore.IsSearching}" />
            <Button Classes="r" Content="{c:T btn_cancel}" Command="{Binding Explore.CancelCommand}" IsVisible="{Binding Explore.IsSearching}" Padding="10,2" />
          </StackPanel>
        </v:CollapsibleSection.HeaderContent>
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
          <TextBlock Classes="muted" Text="{Binding Explore.StatusLine}" TextWrapping="Wrap"
                     IsVisible="{Binding Explore.StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding Explore.HasUnconfirmed}">
            <TextBlock x:Name="UnconfirmedText" Text="{Binding Explore.UnconfirmedText}" VerticalAlignment="Center" />
            <Button Classes="link" Content="{Binding Explore.UnconfirmedToggleText}" Command="{Binding Explore.ToggleUnconfirmedCommand}" />
          </StackPanel>
          <c:LoadingText Grid.Row="2" x:Name="ResultsLoadingText" What="{c:T load_results}" IsVisible="{Binding Explore.ResultsLoading}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Explore.Rows}" HeadersVisibility="Column" CanUserSortColumns="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowDetailsVisibilityMode="Collapsed" Grid.Row="2" IsVisible="{Binding !Explore.ResultsLoading}">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="ResultsThumbMenu" Header="{c:T mnu_thumb}" Command="{Binding Explore.SaveThumbnailCommand}"
                        CommandParameter="{Binding #ResultsGrid.SelectedItem}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40">
              <DataTemplate x:DataType="vm:ExploreRow">
                <CheckBox IsChecked="{Binding Selected}" IsVisible="{Binding CanSelect}" HorizontalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{c:T sc_col_title}" Width="*">
              <DataTemplate x:DataType="vm:ExploreRow">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False">
                  <TextBlock Text="▸" Classes="muted" IsVisible="{Binding !Expanded}" />
                  <TextBlock Text="▾" Classes="muted" IsVisible="{Binding Expanded}" />
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{c:T sc_col_date}" Binding="{Binding DateText}" Width="115" IsReadOnly="True" />
            <DataGridTextColumn Header="{c:T sc_col_dur}" Binding="{Binding DurationText}" Width="105" IsReadOnly="True" />
            <DataGridTextColumn Header="{c:T sc_col_views}" Binding="{Binding ViewsText}" Width="90" IsReadOnly="True" />
            <DataGridTemplateColumn Header="{c:T sc_col_status}" Width="140">
              <DataTemplate x:DataType="vm:ExploreRow">
                <Panel Margin="10,0">
                  <TextBlock Text="{Binding Status}" VerticalAlignment="Center" IsVisible="{Binding !CanExpand}" />
                  <Button Content="{c:T sc_expand}" Padding="8,2" IsVisible="{Binding CanExpand}"
                          Command="{Binding $parent[UserControl].((vm:ScrapingViewModel)DataContext).Explore.ExpandCommand}"
                          CommandParameter="{Binding}" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate x:DataType="vm:ExploreRow">
              <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0" Padding="12,10">
                <ContentControl Content="{Binding Card}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:QueueRowCard">
                      <v:VideoCard />
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Border>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>
        <!-- Without a confirmed date: apart, unchecked -->
        <Border Grid.Row="3" Classes="card" IsVisible="{Binding Explore.ShowUnconfirmed}" MaxHeight="190">
          <StackPanel Spacing="4">
            <TextBlock Classes="muted" Text="{c:T sc_unconf_title}" TextWrapping="Wrap" />
            <DataGrid x:Name="UnconfirmedGrid" ItemsSource="{Binding Explore.UnconfirmedRows}" HeadersVisibility="Column" CanUserSortColumns="False"
                      CanUserReorderColumns="False" SelectionMode="Single" MaxHeight="140">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                  <DataTemplate x:DataType="vm:ExploreRow">
                    <CheckBox IsChecked="{Binding Selected}" IsVisible="{Binding CanSelect}" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{c:T sc_col_title}" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="{c:T sc_col_date}" Binding="{Binding DateText}" Width="115" IsReadOnly="True" />
                <DataGridTextColumn Header="{c:T sc_col_dur}" Binding="{Binding DurationText}" Width="105" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        </Grid>
      </v:CollapsibleSection>
      <Border Grid.Row="3" Classes="card" IsVisible="{Binding Explore.HasSearched}">
        <WrapPanel ItemSpacing="24" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <!-- Selección: one group with its title; Reiniciar apart, in red -->
            <Border x:Name="SelectionGroup" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="4" Padding="8,2,8,6">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" Text="{c:T sc_selection}" FontSize="11" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{c:T sc_all}" Command="{Binding Explore.SelectAllCommand}" />
                  <Button Content="{c:T sc_none}" Command="{Binding Explore.SelectNoneCommand}" />
                  <Button Content="{c:T sc_invert}" Command="{Binding Explore.InvertCommand}" />
                  <TextBlock Classes="muted" Text="{Binding Explore.SelectedText}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Button x:Name="ResetButton" Classes="r" Content="{c:T sc_reset}" Command="{Binding Explore.ResetCommand}" VerticalAlignment="Bottom" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <ComboBox ItemsSource="{Binding Explore.Format.ProfileChoices}" SelectedItem="{Binding Explore.Format.PickedProfile}"
                      PlaceholderText="{c:T ph_profile}" MinWidth="170" AutomationProperties.Name="{c:T lbl_profile}" />
            <ComboBox ItemsSource="{Binding Explore.Format.FormatChoices}" SelectedItem="{Binding Explore.Format.SelectedFormat}" MinWidth="200" />
            <ComboBox ItemsSource="{Binding Explore.Format.ResolutionChoices}" SelectedItem="{Binding Explore.Format.SelectedResolution}" MinWidth="90" />
            <CheckBox Content="{c:T chk_cfr}" IsChecked="{Binding Explore.Format.ConstantRate}" ToolTip.Tip="{c:T tip_cfr}" />
            <Button Classes="o" Content="{c:T sc_to_queue}" Command="{Binding Explore.SendToQueueCommand}" IsEnabled="{Binding Explore.IsIdle}" />
            <Button Classes="g" Content="{c:T sc_subscribe}" Command="{Binding SubscribeFromExploreCommand}" IsEnabled="{Binding Explore.IsIdle}" />
          </StackPanel>
        </WrapPanel>
      </Border>
    </Grid>

    <!-- Suscripciones (SCRAPING_SPEC 2) -->
    <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8" IsVisible="{Binding ShowSubscriptions}">
      <DataGrid x:Name="SubsGrid" ItemsSource="{Binding Subscriptions.Rows}" SelectedItem="{Binding Subscriptions.Selected}" SelectionMode="Single"
                HeadersVisibility="Column" CanUserSortColumns="False" CanUserReorderColumns="False" IsEnabled="{Binding Subscriptions.IsIdle}">
        <DataGrid.ContextMenu>
          <ContextMenu x:Name="SubsMenu">
            <!-- On a subscription -->
            <MenuItem Header="{c:T mnu_sub_check}" Command="{Binding Subscriptions.CheckSelectedCommand}" IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <MenuItem Header="{c:T mnu_sub_pause}" Command="{Binding Subscriptions.TogglePauseCommand}" IsVisible="{Binding Subscriptions.SelectedActive}" />
            <MenuItem Header="{c:T mnu_sub_resume}" Command="{Binding Subscriptions.TogglePauseCommand}" IsVisible="{Binding Subscriptions.SelectedPaused}" />
            <MenuItem Header="{c:T mnu_sub_edit}" Command="{Binding Subscriptions.EditCommand}" IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <Separator IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <MenuItem Header="{c:T mnu_sub_channel}" Command="{Binding Subscriptions.OpenChannelCommand}" IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <MenuItem Header="{c:T mnu_sub_copy}" Command="{Binding Subscriptions.CopyChannelLinkCommand}" IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <MenuItem Header="{c:T mnu_sub_folder}" Command="{Binding Subscriptions.OpenDownloadsFolderCommand}" IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <Separator IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <MenuItem Header="{c:T mnu_sub_remove}" Command="{Binding Subscriptions.RemoveCommand}" IsVisible="{Binding Subscriptions.MenuOnRow}" />
            <!-- On the empty space -->
            <MenuItem Header="{c:T mnu_sub_add}" Command="{Binding Subscriptions.AddCommand}" IsVisible="{Binding !Subscriptions.MenuOnRow}" />
            <MenuItem Header="{c:T mnu_sub_checkall}" Command="{Binding Subscriptions.CheckAllCommand}" IsVisible="{Binding !Subscriptions.MenuOnRow}" />
            <MenuItem Header="{c:T mnu_sub_pauseall}" Command="{Binding Subscriptions.PauseAllCommand}" IsVisible="{Binding !Subscriptions.MenuOnRow}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{c:T sc_col_on}" Width="80">
            <DataTemplate x:DataType="vm:SubscriptionRow">
              <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{c:T sc_col_channel}" Width="*">
            <DataTemplate x:DataType="vm:SubscriptionRow">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                         Classes.err="{Binding HasError}" Classes.off="{Binding !Enabled}"
                         ToolTip.Tip="{Binding Error}" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{c:T sc_col_what}" Binding="{Binding What}" Width="170" IsReadOnly="True" />
          <DataGridTextColumn Header="{c:T sc_col_filters}" Binding="{Binding FiltersText}" Width="*" IsReadOnly="True" />
          <DataGridTextColumn Header="{c:T sc_col_profile}" Binding="{Binding ProfileText}" Width="170" IsReadOnly="True" />
          <DataGridTextColumn Header="{c:T sc_col_format}" Binding="{Binding FormatText}" Width="120" IsReadOnly="True" />
          <DataGridTextColumn Header="{c:T sc_col_last}" Binding="{Binding LastText}" Width="110" IsReadOnly="True" />
          <DataGridTextColumn Header="{c:T sc_col_newcount}" Binding="{Binding NewText}" Width="90" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Subscriptions.StatusLine}" TextWrapping="Wrap"
                 IsVisible="{Binding Subscriptions.StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Border Grid.Row="2" Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="o" Content="{c:T sc_add}" Command="{Binding Subscriptions.AddCommand}" IsEnabled="{Binding Subscriptions.IsIdle}" />
            <Button Content="{c:T sc_edit}" Command="{Binding Subscriptions.EditCommand}" IsEnabled="{Binding Subscriptions.IsIdle}" />
            <Button Classes="r" Content="{c:T sc_remove}" Command="{Binding Subscriptions.RemoveCommand}" IsEnabled="{Binding Subscriptions.IsIdle}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="{c:T sc_check_now}" Command="{Binding Subscriptions.CheckSelectedCommand}" IsVisible="{Binding Subscriptions.IsIdle}" />
            <Button Classes="g" Content="{c:T sc_check_all}" Command="{Binding Subscriptions.CheckAllCommand}" IsVisible="{Binding Subscriptions.IsIdle}" />
            <Button Classes="r" Content="{c:T sc_stop_check}" Command="{Binding Subscriptions.StopCheckCommand}" IsVisible="{Binding Subscriptions.IsChecking}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="3" Classes="card">
        <StackPanel Spacing="7">
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <CheckBox Content="{c:T sc_check_start}" IsChecked="{Binding Subscriptions.CheckOnStart}" />
            <CheckBox Content="{c:T sc_every_pre}" IsChecked="{Binding Subscriptions.CheckEvery}" />
            <NumericUpDown Value="{Binding Subscriptions.EveryHours}" Minimum="1" Maximum="24" Increment="1" FormatString="0" Width="110" />
            <TextBlock Text="{c:T sc_every_post}" VerticalAlignment="Center" />
          </WrapPanel>
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <CheckBox Content="{c:T sc_task}" IsChecked="{Binding Subscriptions.TaskInstalled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" />
            <Button Content="{c:T sc_task_config}" Command="{Binding Subscriptions.ConfigureTaskCommand}" />
            <Button Content="{c:T sc_task_remove}" Command="{Binding Subscriptions.RemoveTaskCommand}" IsVisible="{Binding Subscriptions.TaskInstalled}" />
          </WrapPanel>
          <TextBlock Classes="muted" Text="{c:T sc_subs_note}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{c:T sc_warn_account}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
