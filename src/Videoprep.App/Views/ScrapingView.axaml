<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Videoprep.App.ViewModels"
             xmlns:s="using:Videoprep.App.Services"
             x:Class="Videoprep.App.Views.ScrapingView"
             x:DataType="vm:ScrapingViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="4,10,4,4">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ToggleButton x:Name="ExploreButton" Content="{s:T sc_explore}" IsChecked="{Binding ShowExplore, Mode=OneWay}" />
      <ToggleButton x:Name="SubsButton" Content="{s:T sc_subs}" IsChecked="{Binding ShowSubscriptions, Mode=OneWay}" />
    </StackPanel>

    <!-- Explorar (SCRAPING_SPEC 1) -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8" IsVisible="{Binding ShowExplore}">
      <Border Classes="card">
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SourceBox" Text="{Binding Explore.SourceText}" PlaceholderText="{s:T sc_url_ph}" IsEnabled="{Binding Explore.IsIdle}" />
            <Panel Grid.Column="1">
              <Button Classes="o" Content="{s:T sc_search}" Command="{Binding Explore.SearchCommand}" IsVisible="{Binding Explore.IsIdle}" />
              <Button Classes="r" Content="{s:T sc_cancel}" Command="{Binding Explore.CancelCommand}" IsVisible="{Binding Explore.IsSearching}" />
            </Panel>
          </Grid>
          <WrapPanel ItemSpacing="10" LineSpacing="4">
            <TextBlock Classes="muted" Text="{s:T sc_tabs}" VerticalAlignment="Center" />
            <CheckBox Content="{s:T sc_tabs_videos}" IsChecked="{Binding Explore.TabVideos}" />
            <CheckBox Content="{s:T sc_tabs_shorts}" IsChecked="{Binding Explore.TabShorts}" />
            <CheckBox Content="{s:T sc_tabs_streams}" IsChecked="{Binding Explore.TabStreams}" />
            <CheckBox Content="{s:T sc_tabs_playlists}" IsChecked="{Binding Explore.TabPlaylists}" />
            <TextBlock Classes="muted" Text="{s:T sc_tabs_hint}" VerticalAlignment="Center" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Classes="card">
        <StackPanel Spacing="7">
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBlock Classes="muted" Text="{s:T sc_from}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.FromText}" Width="110" PlaceholderText="{s:T sc_date_ph}" Classes.bad="{Binding Explore.FromBad}" />
            <TextBlock Classes="muted" Text="{s:T sc_to}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.ToText}" Width="110" PlaceholderText="{s:T sc_date_ph}" Classes.bad="{Binding Explore.ToBad}" />
            <TextBlock Classes="muted" Text="{s:T sc_dur_min}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBox Text="{Binding Explore.MinText}" Width="80" PlaceholderText="M:SS" Classes.bad="{Binding Explore.MinBad}" />
            <TextBlock Classes="muted" Text="{s:T sc_dur_max}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.MaxText}" Width="80" PlaceholderText="H:MM:SS" Classes.bad="{Binding Explore.MaxBad}" />
          </WrapPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBlock Classes="muted" Text="{s:T sc_incl}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.IncludeText}" Width="170" />
            <TextBlock Classes="muted" Text="{s:T sc_excl}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.ExcludeText}" Width="170" />
            <TextBlock Classes="muted" Text="{s:T sc_max}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Explore.MaxCountText}" Width="70" Classes.bad="{Binding Explore.MaxCountBad}" />
          </WrapPanel>
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <TextBlock Classes="muted" Text="{s:T sc_order}" VerticalAlignment="Center" />
            <ComboBox SelectedIndex="{Binding Explore.OrderIndex}" MinWidth="170">
              <ComboBoxItem Content="{s:T sc_order_new}" />
              <ComboBoxItem Content="{s:T sc_order_old}" />
            </ComboBox>
            <CheckBox Content="{s:T sc_skip_live}" IsChecked="{Binding Explore.SkipLive}" />
            <CheckBox Content="{s:T sc_skip_members}" IsChecked="{Binding Explore.SkipMembers}" />
            <CheckBox Content="{s:T sc_skip_done}" IsChecked="{Binding Explore.SkipDone}" />
            <Button Content="{s:T sc_apply}" Command="{Binding Explore.ApplyFiltersCommand}" IsEnabled="{Binding Explore.IsIdle}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Explore.StatusLine}" TextWrapping="Wrap"
                 IsVisible="{Binding Explore.StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <DataGrid Grid.Row="3" ItemsSource="{Binding Explore.Rows}" HeadersVisibility="Column" CanUserSortColumns="False"
                CanUserReorderColumns="False" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="40">
            <DataTemplate x:DataType="vm:ExploreRow">
              <CheckBox IsChecked="{Binding Selected}" IsVisible="{Binding CanSelect}" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{s:T sc_col_title}" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_date}" Binding="{Binding DateText}" Width="115" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_dur}" Binding="{Binding DurationText}" Width="105" IsReadOnly="True" />
          <DataGridTextColumn Header="{s:T sc_col_views}" Binding="{Binding ViewsText}" Width="90" IsReadOnly="True" />
          <DataGridTemplateColumn Header="{s:T sc_col_status}" Width="140">
            <DataTemplate x:DataType="vm:ExploreRow">
              <Panel Margin="10,0">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" IsVisible="{Binding !CanExpand}" />
                <Button Content="{s:T sc_expand}" Padding="8,2" IsVisible="{Binding CanExpand}"
                        Command="{Binding $parent[UserControl].((vm:ScrapingViewModel)DataContext).Explore.ExpandCommand}"
                        CommandParameter="{Binding}" />
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="4" Classes="muted" Text="{s:T sc_approx_note}" TextWrapping="Wrap" IsVisible="{Binding Explore.HasApproxDates}" />
      <Border Grid.Row="5" Classes="card">
        <WrapPanel ItemSpacing="24" LineSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{s:T sc_all}" Command="{Binding Explore.SelectAllCommand}" />
            <Button Content="{s:T sc_none}" Command="{Binding Explore.SelectNoneCommand}" />
            <Button Content="{s:T sc_invert}" Command="{Binding Explore.InvertCommand}" />
            <TextBlock Classes="muted" Text="{Binding Explore.SelectedText}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" Text="{s:T lbl_fmt}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Explore.FormatChoices}" SelectedItem="{Binding Explore.SelectedFormat}" MinWidth="200" />
            <ComboBox ItemsSource="{Binding Explore.ResolutionChoices}" SelectedItem="{Binding Explore.SelectedResolution}" MinWidth="90" />
            <Button Classes="o" Content="{s:T sc_to_queue}" Command="{Binding Explore.SendToQueueCommand}" IsEnabled="{Binding Explore.IsIdle}" />
            <Button Classes="g" Content="{s:T sc_subscribe}" IsEnabled="False" ToolTip.Tip="{s:T sc_subs_later}" />
          </StackPanel>
        </WrapPanel>
      </Border>
    </Grid>

    <!-- Suscripciones: still the approved mockup until tanda B -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8" IsVisible="{Binding ShowSubscriptions}">
      <Border Classes="note">
        <TextBlock Text="{s:T sc_subs_later}" TextWrapping="Wrap" />
      </Border>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Sample.Subscriptions}" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="{s:T sc_col_on}" Binding="{Binding Enabled}" Width="60" />
          <DataGridTextColumn Header="{s:T sc_col_channel}" Binding="{Binding Channel}" Width="*" />
          <DataGridTextColumn Header="{s:T sc_col_what}" Binding="{Binding What}" Width="140" />
          <DataGridTextColumn Header="{s:T sc_col_filters}" Binding="{Binding Filters}" Width="*" />
          <DataGridTextColumn Header="{s:T sc_col_format}" Binding="{Binding Format}" Width="100" />
          <DataGridTextColumn Header="{s:T sc_col_last}" Binding="{Binding Last}" Width="100" />
          <DataGridTextColumn Header="{s:T sc_col_newcount}" Binding="{Binding New}" Width="70" />
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Row="2" Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="o" Content="{s:T sc_add}" IsEnabled="False" />
            <Button Content="{s:T sc_edit}" IsEnabled="False" />
            <Button Classes="r" Content="{s:T sc_remove}" IsEnabled="False" />
          </StackPanel>
          <Button Grid.Column="2" Classes="g" Content="{s:T sc_check_now}" IsEnabled="False" />
        </Grid>
      </Border>
      <Border Grid.Row="3" Classes="card">
        <StackPanel Spacing="7">
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <CheckBox Content="{s:T sc_check_start}" IsChecked="True" IsEnabled="False" />
            <CheckBox IsEnabled="False">
              <TextBlock Text="{Binding Sample.CheckEveryText}" />
            </CheckBox>
          </WrapPanel>
          <WrapPanel ItemSpacing="10" LineSpacing="6">
            <CheckBox Content="{s:T sc_task}" IsEnabled="False" />
            <Button Content="{s:T sc_task_config}" IsEnabled="False" />
          </WrapPanel>
          <TextBlock Classes="muted" Text="{s:T sc_subs_note}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
