<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Videoprep.App.ViewModels"
             xmlns:s="using:Videoprep.App.Services"
             x:Class="Videoprep.App.Views.DownloadView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8" Margin="4,10,4,4">

    <!-- Link: paste here (several links at once go straight to the queue) -->
    <TextBox Grid.Row="0" x:Name="LinkBox" Text="{Binding LinkText}" PlaceholderText="{s:T ph_link}"
             IsEnabled="{Binding IsIdle}" FontSize="14" Padding="8,6" DragDrop.AllowDrop="True" />

    <!-- Format -->
    <Border Grid.Row="1" Classes="card">
      <StackPanel Spacing="6">
        <WrapPanel ItemSpacing="10" LineSpacing="6">
          <TextBlock Classes="muted" Text="{s:T lbl_type}" VerticalAlignment="Center" />
          <RadioButton GroupName="kind" Content="{s:T rad_video}" IsChecked="{Binding IsVideo}" IsEnabled="{Binding IsIdle}" />
          <RadioButton GroupName="kind" Content="{s:T rad_audio}" IsChecked="{Binding IsAudio}" IsEnabled="{Binding IsIdle}" />
          <TextBlock Classes="muted" Text="{s:T lbl_fmt}" VerticalAlignment="Center" Margin="12,0,0,0" />
          <ComboBox x:Name="FormatBox" ItemsSource="{Binding FormatChoices}" SelectedItem="{Binding SelectedFormat}"
                    MinWidth="210" IsEnabled="{Binding IsIdle}" />
          <TextBlock Classes="muted" Text="{s:T lbl_res}" VerticalAlignment="Center" Margin="12,0,0,0" />
          <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding SelectedResolution}"
                    MinWidth="100" IsEnabled="{Binding ResolutionEnabled}" />
          <!-- F6: a profile fills the format, the resolution and the names -->
          <TextBlock Classes="muted" Text="{s:T lbl_profile}" VerticalAlignment="Center" Margin="12,0,0,0" />
          <ComboBox x:Name="ProfileBox" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfileChoice}"
                    PlaceholderText="{s:T ph_profile}" MinWidth="190" IsEnabled="{Binding IsIdle}"
                    AutomationProperties.Name="{s:T lbl_profile}" />
          <Button Content="{s:T btn_saveprofile}" Command="{Binding SaveProfileCommand}" ToolTip.Tip="{s:T tip_saveprofile}"
                  IsEnabled="{Binding IsIdle}" />
        </WrapPanel>
        <TextBlock Classes="muted" Text="{Binding HintText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Clips | Preview -->
    <Grid Grid.Row="2" ColumnDefinitions="*,300" ColumnSpacing="8">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" Text="{s:T lbl_clips}" VerticalAlignment="Center" />
            <TextBlock Text="(?)" Foreground="{DynamicResource Ot}" Cursor="Help" VerticalAlignment="Center"
                       ToolTip.Tip="{s:T tip_tc}" ToolTip.ShowDelay="250" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Clips}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipRowViewModel">
                  <StackPanel Margin="0,0,0,6" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="muted" Text="{s:T lbl_start}" VerticalAlignment="Center" Width="44" />
                      <TextBox Text="{Binding Start}" Width="120" Classes.bad="{Binding StartBad}" PlaceholderText="00:00:00:00" />
                      <TextBlock Classes="muted" Text="{s:T lbl_end}" VerticalAlignment="Center" Margin="6,0,0,0" />
                      <TextBox Text="{Binding End}" Width="120" Classes.bad="{Binding EndBad}" PlaceholderText="00:00:00:00" />
                      <Button Content="X" Command="{Binding RemoveCommand}" Padding="9,4" />
                    </StackPanel>
                    <!-- F2: beyond the video duration (only a warning) -->
                    <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" Foreground="{DynamicResource Rt}" Margin="52,0,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="2" Content="{s:T btn_addclip}" Command="{Binding AddClipCommand}" IsEnabled="{Binding IsIdle}" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <!-- The picture shrinks first, so the title and the lines under it always fit. -->
        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
          <Border Background="{DynamicResource Bg}" MaxHeight="158" MinHeight="40" CornerRadius="2">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
          </Border>
          <TextBlock Grid.Row="1" x:Name="PreviewTitle" Classes="title" Text="{Binding PreviewTitle}" TextWrapping="Wrap" MaxLines="2"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="2" Classes="muted" Text="{Binding PreviewMeta}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </Grid>

    <!-- File names + Options / Send to queue -->
    <Border Grid.Row="3" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="6">
          <TextBlock Classes="muted" Text="{s:T lbl_names}" />
          <RadioButton GroupName="names" Content="{s:T rad_n1}" IsChecked="{Binding NameOriginal}" IsEnabled="{Binding IsIdle}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton GroupName="names" Content="{s:T rad_n2}" IsChecked="{Binding NameCustom}" IsEnabled="{Binding IsIdle}" Width="210" />
            <TextBox Text="{Binding CustomText}" Width="240" IsEnabled="{Binding CustomEnabled}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton GroupName="names" Content="{s:T rad_n3}" IsChecked="{Binding NameSeries}" IsEnabled="{Binding IsIdle}" Width="210" />
            <TextBox Text="{Binding SeriesText}" Width="240" IsEnabled="{Binding SeriesEnabled}" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding ExampleText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" Width="170">
          <Button Content="{s:T btn_options}" Command="{Binding ShowOptionsCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" IsEnabled="{Binding IsIdle}" />
          <Button Classes="o" Content="{s:T btn_send}" Command="{Binding SendToQueueCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Padding="12,9" IsEnabled="{Binding IsIdle}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Folder + Download / Stop -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
      <Button Content="📁" Command="{Binding OpenSaveFolderCommand}" ToolTip.Tip="{s:T tip_folder}" Padding="9,5" />
      <Button Grid.Column="1" Content="{s:T btn_browse}" Command="{Binding BrowseFolderCommand}" IsEnabled="{Binding IsIdle}" />
      <TextBlock Grid.Column="2" Classes="muted" Text="{s:T lbl_saveto}" VerticalAlignment="Center" />
      <TextBox Grid.Column="3" Text="{Binding Folder}" IsEnabled="{Binding IsIdle}" />
      <!-- F4: the mini window (variante B) -->
      <Button Grid.Column="4" x:Name="MiniButton" Classes="o" Content="{s:T btn_mini}" Command="{Binding ToggleMiniCommand}"
              ToolTip.Tip="{s:T tip_mini}" Padding="14,8" />
      <Button Grid.Column="5" Classes="g" Content="{s:T btn_download}" Command="{Binding DownloadCommand}"
              FontWeight="Bold" Padding="18,8" IsEnabled="{Binding IsIdle}" />
      <Button Grid.Column="6" Classes="r" Content="{s:T btn_stop}" Command="{Binding StopCommand}"
              Padding="14,8" IsEnabled="{Binding IsRunning}" />
    </Grid>

    <!-- Progress -->
    <StackPanel Grid.Row="5" Spacing="4">
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}" Height="8" />
      <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" />
    </StackPanel>
  </Grid>
</UserControl>
