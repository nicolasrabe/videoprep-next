<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Videoprep.App.ViewModels"
             xmlns:s="using:Videoprep.App.Services"
             x:Class="Videoprep.App.Views.SettingsView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="4,10,12,4" MaxWidth="900" HorizontalAlignment="Left">
      <!-- Login cookies -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="260,*" ColumnSpacing="8">
            <TextBlock Text="{s:T lbl_cookies}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CookieChoices}" SelectedIndex="{Binding SelectedCookieIndex}"
                      HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
          </Grid>
          <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="8">
            <TextBlock Text="{s:T lbl_cookiefile}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding CookieFile}" IsEnabled="{Binding IsIdle}" />
            <Button Grid.Column="2" Content="{s:T btn_browse}" Command="{Binding BrowseCookieFileCommand}" IsEnabled="{Binding IsIdle}" />
          </Grid>
          <TextBlock Classes="muted" Text="{s:T txt_privacy}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{s:T txt_cookie_export}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Tools -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="{s:T grp_tools}" />
          <TextBlock x:Name="ToolsText" Text="{Binding ToolsStatus}" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{s:T btn_recheck}" Command="{Binding RecheckToolsCommand}" IsEnabled="{Binding IsIdle}" />
            <Button Content="{s:T btn_update}" Command="{Binding UpdateToolsCommand}" IsEnabled="{Binding IsIdle}" />
          </StackPanel>
          <CheckBox Content="{s:T chk_autoupdate}" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding IsIdle}" />
        </StackPanel>
      </Border>

      <!-- When a batch finishes -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <CheckBox Content="{s:T chk_sound}" IsChecked="{Binding Sound}" IsEnabled="{Binding IsIdle}" />
          <CheckBox Content="{s:T chk_opendone}" IsChecked="{Binding OpenDone}" IsEnabled="{Binding IsIdle}" />
          <Button Content="{s:T btn_cleararchive}" Command="{Binding ClearArchiveCommand}" IsEnabled="{Binding IsIdle}" />
        </StackPanel>
      </Border>

      <!-- F4 / F5: mini window and clipboard -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <CheckBox Content="{s:T set_miniontop}" IsChecked="{Binding MiniOnTop}" />
          <CheckBox Content="{s:T chk_clipwatch}" IsChecked="{Binding ClipboardWatch}" />
          <!-- The privacy note sits right under the option -->
          <TextBlock Classes="muted" Text="{s:T txt_clipprivacy}" TextWrapping="Wrap" Margin="26,0,0,0" />
        </StackPanel>
      </Border>

      <!-- F7: list of sources -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="{s:T grp_sources}" />
          <CheckBox Content="{s:T chk_sources}" IsChecked="{Binding SourceListOn}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0">
            <TextBlock Classes="muted" Text="{s:T lbl_sources_fmt}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SourceListFormats}" SelectedIndex="{Binding SourceListFormatIndex}" MinWidth="200"
                      IsEnabled="{Binding SourceListOn}" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{s:T txt_sources_help}" TextWrapping="Wrap" Margin="26,0,0,0" />
        </StackPanel>
      </Border>

      <!-- F6: profiles -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="{s:T grp_profiles}" />
          <TextBlock Classes="muted" Text="{s:T txt_profiles_help}" TextWrapping="Wrap" />
          <DataGrid ItemsSource="{Binding ManagedProfiles}" SelectedItem="{Binding SelectedManagedProfile}" SelectionMode="Single"
                    HeadersVisibility="None" IsReadOnly="True" MaxHeight="190" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding Label}" Width="2*" />
              <DataGridTextColumn Binding="{Binding Detail}" Width="3*" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="{s:T btn_prof_rename}" Command="{Binding RenameProfileCommand}" IsEnabled="{Binding IsIdle}" />
            <Button Content="{s:T btn_prof_delete}" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding IsIdle}" />
            <Button Content="{s:T btn_prof_export}" Command="{Binding ExportProfilesCommand}" />
            <Button Content="{s:T btn_prof_import}" Command="{Binding ImportProfilesCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Appearance -->
      <Border Classes="card">
        <WrapPanel ItemSpacing="10" LineSpacing="8">
          <TextBlock Text="{s:T lbl_theme}" VerticalAlignment="Center" />
          <ComboBox x:Name="ThemeBox" ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding SelectedThemeIndex}" MinWidth="190" />
          <Button Content="{s:T btn_pickcolor}" Command="{Binding PickColorCommand}" IsVisible="{Binding IsCustomTheme}" />
          <TextBlock Text="{s:T lbl_lang}" VerticalAlignment="Center" Margin="20,0,0,0" />
          <ComboBox x:Name="LangBox" ItemsSource="{Binding LanguageChoices}" SelectedIndex="{Binding SelectedLanguageIndex}" MinWidth="150" />
        </WrapPanel>
      </Border>

      <TextBlock Classes="muted" Text="{Binding AboutText}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
