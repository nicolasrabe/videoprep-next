<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Videoprep.App.ViewModels"
        xmlns:v="using:Videoprep.App.Views"
        xmlns:s="using:Videoprep.App.Services"
        x:Class="Videoprep.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="videoprep"
        Width="1000" Height="740" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <!-- Resizable (AUDIT M7: the legacy window was a fixed 760x640). -->
  <Grid RowDefinitions="Auto,*">
  <!-- F9: a newer videoprep exists. Installing always waits for the click on "Actualizar". -->
  <Border x:Name="UpdateBanner" Classes="card" IsVisible="{Binding UpdateBannerVisible}" Margin="8,6,8,0">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock x:Name="UpdateBannerText" Text="{Binding UpdateBannerText}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="{s:T upd_notes}" Command="{Binding OpenReleaseNotesCommand}" />
      <Button Grid.Column="2" x:Name="UpdateInstallButton" Content="{s:T upd_install}" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsIdle}" />
      <Button Grid.Column="3" Content="{s:T upd_later}" Command="{Binding DismissUpdateCommand}" />
    </Grid>
  </Border>
  <TabControl Grid.Row="1" x:Name="Tabs" SelectedIndex="{Binding SelectedTab}" Padding="0" Margin="8,4,8,8">
    <TabItem x:Name="TabDownload" Header="{s:T tab_dl}">
      <v:DownloadView />
    </TabItem>
    <TabItem x:Name="TabQueue" Header="{s:T tab_q}">
      <v:QueueView />
    </TabItem>
    <TabItem x:Name="TabScraping" Header="{s:T tab_scraping}">
      <v:ScrapingView DataContext="{Binding Scraping}" />
    </TabItem>
    <TabItem x:Name="TabSettings" Header="{s:T tab_st}">
      <v:SettingsView />
    </TabItem>
    <TabItem x:Name="TabLog" Header="{s:T tab_log}">
      <v:LogView />
    </TabItem>
  </TabControl>
  </Grid>
</Window>
