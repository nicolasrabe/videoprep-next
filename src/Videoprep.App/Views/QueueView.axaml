<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Videoprep.App.ViewModels"
             xmlns:s="using:Videoprep.App.Services"
             x:Class="Videoprep.App.Views.QueueView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">
  <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" RowSpacing="8" Margin="4,10,4,4">
    <!-- One row open at a time (F3): the view shows the details of the row the view model marks as expanded. -->
    <DataGrid x:Name="Grid" ItemsSource="{Binding QueueRows}" IsReadOnly="False" SelectionMode="Extended"
              CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column"
              RowDetailsVisibilityMode="Collapsed">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="MenuRename" Header="{s:T mnu_rename}" IsEnabled="{Binding CanEditOne}" />
          <MenuItem Header="{s:T mnu_batch}" Command="{Binding BatchEditCommand}" IsEnabled="{Binding CanEditSelection}" />
          <MenuItem Header="{s:T mnu_edit}" Command="{Binding EditSelectedCommand}" IsEnabled="{Binding CanEditOne}" />
          <Separator />
          <MenuItem Header="{s:T mnu_dup}" Command="{Binding DuplicateCommand}" IsEnabled="{Binding CanChangeSelection}" />
          <MenuItem Header="{s:T btn_up}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanChangeSelection}" />
          <MenuItem Header="{s:T btn_down}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanChangeSelection}" />
          <MenuItem Header="{s:T mnu_requeue}" Command="{Binding RequeueCommand}" IsEnabled="{Binding CanRequeue}" />
          <MenuItem Header="{s:T mnu_showfolder}" Command="{Binding ShowInFolderCommand}" IsEnabled="{Binding CanShowInFolder}" />
          <Separator />
          <MenuItem Header="{s:T mnu_remove}" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding CanChangeSelection}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{s:T col_num}" Binding="{Binding Num}" Width="56" IsReadOnly="True" />
        <DataGridTemplateColumn Header="{s:T col_name}" Width="2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:QueueRow">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="▸" Classes="muted" IsVisible="{Binding !IsExpanded}" />
                <TextBlock Text="▾" Classes="muted" IsVisible="{Binding IsExpanded}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate x:DataType="vm:QueueRow">
              <TextBox Text="{Binding EditName}" Padding="6,2" MinHeight="24" AutomationProperties.Name="{s:T col_name}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{s:T col_fmt}" Binding="{Binding Format}" Width="235" IsReadOnly="True" />
        <DataGridTextColumn Header="{s:T col_clip}" Binding="{Binding Clip}" Width="160" IsReadOnly="True" />
        <DataGridTextColumn Header="{s:T col_status}" Binding="{Binding Status}" Width="110" IsReadOnly="True" />
        <DataGridTextColumn Header="{s:T col_file}" Binding="{Binding File}" Width="*" IsReadOnly="True" />
      </DataGrid.Columns>
      <DataGrid.RowDetailsTemplate>
        <DataTemplate x:DataType="vm:QueueRow">
          <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0" Padding="12,10">
            <ContentControl Content="{Binding Card}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:QueueRowCard">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <!-- Thumbnail with the duration in a corner -->
                    <Panel Width="240" Height="135" VerticalAlignment="Top">
                      <Border Background="{DynamicResource Bd}" CornerRadius="2" />
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      <Border Background="#CC000000" CornerRadius="2" Padding="5,1" Margin="5"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding HasDuration}">
                        <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="12" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding Meta}" />
                      <!-- Loading: gray bars instead of the text -->
                      <StackPanel Spacing="6" IsVisible="{Binding IsLoading}" Margin="0,4">
                        <TextBlock Classes="muted" Text="{s:T det_loading}" />
                        <Border Classes="sk" Width="320" />
                        <Border Classes="sk" Width="420" />
                        <Border Classes="sk" Width="260" />
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding IsFailed}">
                        <TextBlock Text="{Binding FailText}" Foreground="{DynamicResource Rt}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="{s:T det_retry}" Command="{Binding RetryCommand}" />
                          <TextBlock Classes="muted" Text="{s:T det_fail_hint}" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsReady}">
                        <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Tx}" />
                      </ScrollViewer>
                      <WrapPanel ItemSpacing="10" LineSpacing="6" Margin="0,4,0,0">
                        <Button Classes="link" Command="{Binding OpenLinkCommand}" ToolTip.Tip="{s:T det_open}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Link}" />
                        </Button>
                        <Button Content="{s:T det_open}" Command="{Binding OpenLinkCommand}" />
                        <Button Content="{s:T det_copy}" Command="{Binding CopyLinkCommand}" />
                      </WrapPanel>
                      <TextBlock Classes="muted" Text="{Binding Will}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </DataTemplate>
      </DataGrid.RowDetailsTemplate>
    </DataGrid>
    <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8">
      <Button Content="{s:T btn_edit}" Command="{Binding EditSelectedCommand}" IsEnabled="{Binding IsIdle}" />
      <Button Content="{s:T btn_remove}" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding IsIdle}" />
      <Button Content="{s:T btn_up}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding IsIdle}" />
      <Button Content="{s:T btn_down}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding IsIdle}" />
      <Button Content="{s:T btn_retry}" Command="{Binding RetryFailedCommand}" IsEnabled="{Binding CanRetry}" />
      <Button Content="{s:T btn_undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Ctrl+Z" />
    </WrapPanel>
    <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
      <Button Content="{s:T btn_loadtxt}" Command="{Binding LoadTxtCommand}" IsEnabled="{Binding IsIdle}" />
      <Button Content="{s:T btn_clearq}" Command="{Binding ClearQueueCommand}" IsEnabled="{Binding IsIdle}" />
    </WrapPanel>
    <TextBlock Grid.Row="3" Classes="muted" Text="{s:T lbl_qhelp}" TextWrapping="Wrap" />
    <TextBlock Grid.Row="4" x:Name="QueueStatus" Text="{Binding StatusText}" />
  </Grid>
</UserControl>
