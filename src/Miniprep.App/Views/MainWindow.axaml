<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Videoprep.Controls;assembly=Videoprep.Controls"
        xmlns:vm="using:Miniprep.App.ViewModels"
        xmlns:v="using:Miniprep.App.Views"
        x:Class="Miniprep.App.Views.MainWindow"
        x:DataType="vm:MiniMainViewModel"
        Icon="avares://miniprep/Assets/videoprep.ico"
        Title="miniprep"
        Width="620" Height="700" MinWidth="520" MinHeight="580"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,0,1" Padding="12,6,12,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="PrepTab" Classes="tab" Classes.on="{Binding IsPrepTab}" Content="{c:T tab_dl}" />
        <Button x:Name="ColaTab" Classes="tab" Classes.on="{Binding IsColaTab}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{c:T tab_q}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            <Border IsVisible="{Binding ShowBadge}" MinWidth="18" Padding="6,0" CornerRadius="9" Background="{DynamicResource Ob}" VerticalAlignment="Center">
              <TextBlock Text="{Binding Badge}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Ot}" />
            </Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" IsVisible="{Binding IsPrepTab}"><v:PrepView DataContext="{Binding Prep}" /></Grid>
    <Grid Grid.Row="1" IsVisible="{Binding IsColaTab}"><v:QueueView x:Name="Queue" DataContext="{Binding Cola}" /></Grid>

    <!-- Short notice ("Añadido a la cola") -->
    <Border Grid.Row="1" IsVisible="{Binding ShowToast}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
            Padding="16,8" CornerRadius="3" Background="{DynamicResource Gb}">
      <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Gt}" />
    </Border>
  </Grid>
</Window>
