<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pieces shared by videoprep and miniprep: UI texts (es/en), spinner, title bar colors. -->
  <PropertyGroup>
    <RootNamespace>Videoprep.Controls</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Videoprep.Core\Videoprep.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>
</Project>
