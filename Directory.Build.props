<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Symbols inside the dll/exe so crash logs have line numbers without extra files. -->
    <DebugType>embedded</DebugType>

    <!-- The one place where the version lives (CHANGELOG and README must match). -->
    <VersionPrefix>0.3.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Product>videoprep</Product>
    <Company>videoprep</Company>
    <Copyright>Copyright (c) 2026 nicolasrabe - MIT</Copyright>
  </PropertyGroup>
</Project>
