<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Videoprep.App\Videoprep.App.csproj" />
    <ProjectReference Include="..\FakeYtDlp\FakeYtDlp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Videoprep.Core.Tests\Fixtures\listing\**" LinkBase="Fixtures\listing" CopyToOutputDirectory="PreserveNewest" />
    <!-- Word files for the import tests are built in code (no user documents in the repo). -->
    <Compile Include="..\Videoprep.Core.Tests\DocxBuilder.cs" Link="DocxBuilder.cs" />
    <!-- An in-memory GitHub for the update tests (no network is used). -->
    <Compile Include="..\Videoprep.Core.Tests\UpdateKit.cs" Link="UpdateKit.cs" />
  </ItemGroup>
</Project>
